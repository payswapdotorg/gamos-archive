{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@zcode/gamos-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Gamos game-native platform plugin: World/GameIR tools, package graph with rights and provenance, playtest evidence, release gates, specialist agents, workflow templates, and the Gamos Console panel.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/mcp/server.js",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test",
    "lint": "oxlint src --no-ignore"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
